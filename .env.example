# 微信公众号配置
WECHAT_APP_ID=your_app_id_here
WECHAT_APP_SECRET=your_app_secret_here

# AI 模型配置（默认使用 DeepSeek，兼容任何 OpenAI 格式接口）
# DeepSeek Key 申请：https://platform.deepseek.com/api_keys
AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com/v1
# 推荐模型：deepseek-chat（V3，默认）、deepseek-reasoner（推理更强但更慢）
AI_MODEL=deepseek-chat
# 若要切回 OpenAI：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 文章配置
IMAGES_DIR=./images
USED_IMAGES_DIR=./used
TEMP_DIR=./temp
IMAGES_PER_ARTICLE=10
# 固定标题（可通过环境变量覆盖）
ARTICLE_TITLE_PREFIX=WeChat ins小众高级个性头像10张

# 作者信息（可选）
ARTICLE_AUTHOR=
ARTICLE_DIGEST=

# 定时任务配置（24小时制）
SCHEDULE_TIME=09:00

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
